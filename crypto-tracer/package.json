{
  "name": "crypto-tracer",
  "version": "1.0.0",
  "description": "Terminal-based cryptocurrency transaction tracing application",
  "main": "dist/crypto-tracer/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/crypto-tracer/index.ts",
    "dev:server": "tsx src/crypto-tracer/server.ts",
    "build": "tsc",
    "start": "node dist/crypto-tracer/index.js",
    "start:server": "node dist/crypto-tracer/server.js",
    "test": "vitest run"
  },
  "bin": {
    "crypto-tracer": "dist/crypto-tracer/index.js"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphology": "^0.26.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
